[Unit]
Description=CodeCup Telegram bot
After=network.target postgresql.service codecup-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/codecup
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/codecup/.venv/bin/python manage.py codebot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
