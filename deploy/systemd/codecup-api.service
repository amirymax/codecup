[Unit]
Description=CodeCup API (Django + gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=root
WorkingDirectory=/opt/codecup
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/codecup/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
