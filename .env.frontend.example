# Продакшн-настройки фронтенда. Кладётся на сервер как /opt/codecup/.env.frontend
# Его читает systemd (codecup-web.service) и deploy.sh перед сборкой.

# Адрес API для браузера. Вшивается в сборку при npm run build.
NEXT_PUBLIC_API_URL=https://api.codecup.tech

# Адрес API для рендеринга страниц на сервере Next.js. Через nginx, а не
# 127.0.0.1:8000: backend строит абсолютные ссылки (например, на чеки об
# оплате) по Host запроса, и по loopback они получились бы вида
# http://127.0.0.1:8000/media/... — в браузере такие не откроются.
INTERNAL_API_URL=https://api.codecup.tech
