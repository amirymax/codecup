# Продакшн. Скопируйте в .env.prod на сервере и заполните.
# Файл содержит секреты — в репозиторий он не попадает.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.codecup.tech
CSRF_TRUSTED_ORIGINS=https://codecup.tech,https://api.codecup.tech

# Postgres установлен на сервере, а не в контейнере.
# host.docker.internal — это хост-машина изнутри контейнера.
DATABASE_URL=postgres://codecup:ПАРОЛЬ@host.docker.internal:5432/codecup

# Общий домен для фронтенда и API — иначе кука сессии не уйдёт.
AUTH_COOKIE_DOMAIN=.codecup.tech
CORS_ALLOWED_ORIGINS=https://codecup.tech,https://www.codecup.tech
FRONTEND_URL=https://codecup.tech
NEXT_PUBLIC_API_URL=https://api.codecup.tech

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CodeCupBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_TOKEN_TTL=300
