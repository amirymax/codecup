# Продакшн. Кладётся на сервер как /opt/codecup/.env
# Файл содержит секреты — в репозиторий он не попадает.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.codecup.tech
CSRF_TRUSTED_ORIGINS=https://codecup.tech,https://api.codecup.tech

# Postgres установлен на самом сервере
DATABASE_URL=postgres://codecup:ПАРОЛЬ@127.0.0.1:5432/codecup

# Общий домен для сайта и API — иначе кука сессии не уйдёт
AUTH_COOKIE_DOMAIN=.codecup.tech
CORS_ALLOWED_ORIGINS=https://codecup.tech,https://www.codecup.tech
FRONTEND_URL=https://codecup.tech

# Оплата участия
PAYMENT_REQUISITES="Карта: 0000 0000 0000 0000\nПолучатель: ...\nКомментарий: ваш @username"
TELEGRAM_ADMIN_USERNAME=AmiriCode

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Code_Cup_Bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_TOKEN_TTL=300

# Автопроверка репозиториев (classic-токен без scope)
GITHUB_TOKEN=
