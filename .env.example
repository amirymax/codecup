# Скопируйте в .env и заполните: cp .env.example .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=замените-на-случайную-строку
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных ---
# Должно совпадать с параметрами postgres в docker-compose.yml
POSTGRES_DB=codecup
POSTGRES_USER=codecup
POSTGRES_PASSWORD=codecup
POSTGRES_PORT=5432
DATABASE_URL=postgres://codecup:codecup@127.0.0.1:5432/codecup

# --- Фронтенд ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Куки сессии ---
# Пусто для localhost. В проде — домен, общий для API и фронтенда (.codecup.tech)
AUTH_COOKIE_DOMAIN=

# --- Оплата участия ---
# Реквизиты для платных контестов. Перенос строки записывается как \n
PAYMENT_REQUISITES="Карта: 0000 0000 0000 0000\nПолучатель: CodeCup"
# @username администратора, которому уходят чеки
TELEGRAM_ADMIN_USERNAME=AmiriCode

# --- Автопроверка заявок ---
# Без токена GitHub даёт 60 запросов в час на IP — на контест этого мало.
# Хватит classic-токена без единого scope: нужны только публичные данные.
GITHUB_TOKEN=

# --- Telegram ---
# Токен и имя бота выдаёт @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CodeCupBot
# Произвольная строка: ею подписан и путь вебхука, и заголовок от Telegram
TELEGRAM_WEBHOOK_SECRET=замените-на-случайную-строку
# Сколько секунд живёт ссылка для входа
TELEGRAM_AUTH_TOKEN_TTL=300
